{
  "name": "@daily-ledger/data",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "description": "Shared TanStack Query keys, hooks, and client defaults for Daily Ledger apps",
  "repository": {
    "type": "git",
