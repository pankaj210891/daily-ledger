{
  "name": "@daily-ledger/shared",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Shared date, formatting, and domain helpers for Daily Ledger apps",
  "repository": {
    "type": "git",
    "url": "https://github.com/pankaj210891/daily-ledger.git",
    "directory": "packages/shared"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
